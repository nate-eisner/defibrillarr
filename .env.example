# Defibrillarr Environment Configuration Example

# General Settings
DEBUG=false
DRY_RUN=false
PORT=8787

# Monitoring & Thresholds
POLL_INTERVAL_SECONDS=60
STALL_THRESHOLD_MINUTES=15        # Minutes in stalledDL or speed < 10KB/s before Stage 1 (tracker injection)
RESCUE_GRACE_PERIOD_MINUTES=60    # Minutes to wait with fresh trackers before Stage 2 (Servarr failover)
MIN_DOWNLOAD_SPEED_KBPS=10.0      # Downloads slower than this count as stalled
AUTO_FAILOVER_ENABLED=true        # If false, marks as 'Grace Expired' for 1-click manual trigger in Web UI

# qBittorrent Web UI connection
QBIT_URL=http://192.168.1.100:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin

# Sonarr (TV Shows)
SONARR_URL=http://192.168.1.100:8989
SONARR_API_KEY=your_sonarr_api_key_here

# Radarr (Movies)
RADARR_URL=http://192.168.1.100:7878
RADARR_API_KEY=your_radarr_api_key_here

# Lidarr (Music - optional)
LIDARR_URL=http://192.168.1.100:8686
LIDARR_API_KEY=your_lidarr_api_key_here
